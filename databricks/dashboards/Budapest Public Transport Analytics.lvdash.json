{
  "datasets": [
    {
      "name": "880fc5ec",
      "displayName": "Daily Transport Service Overview Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    departure_date,\r\n",
        "    total_scheduled_departures,\r\n",
        "    active_routes,\r\n",
        "    transport_types\r\n",
        "FROM workspace.default.gold_daily_service\r\n",
        "WHERE snapshot_id = (\r\n",
        "    SELECT MAX(snapshot_id)\r\n",
        "    FROM workspace.default.gold_daily_service\r\n",
        ")\r\n",
        "ORDER BY departure_date;"
      ]
    },
    {
      "name": "3dfcfee5",
      "displayName": "Top 10 Busiest Routes",
      "queryLines": [
        "SELECT\r\n",
        "    route_short_name,\r\n",
        "    route_type,\r\n",
        "    total_trips,\r\n",
        "    unique_stops\r\n",
        "FROM workspace.default.gold_route_statistics\r\n",
        "WHERE snapshot_id = (\r\n",
        "    SELECT MAX(snapshot_id)\r\n",
        "    FROM workspace.default.gold_route_statistics\r\n",
        ")\r\n",
        "AND total_trips > 0\r\n",
        "ORDER BY total_trips DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "815396db",
      "displayName": "Top 10 Busiest Stop",
      "queryLines": [
        "SELECT\r\n",
        "    CONCAT(\r\n",
        "        LEFT(stop_name, 22),\r\n",
        "        CASE WHEN LENGTH(stop_name) > 22 THEN '…' ELSE '' END,\r\n",
        "        ' (', stop_id, ')'\r\n",
        "    ) AS stop_label,\r\n",
        "    total_stop_events,\r\n",
        "    unique_routes\r\n",
        "FROM workspace.default.gold_stop_activity\r\n",
        "WHERE snapshot_id = (\r\n",
        "    SELECT MAX(snapshot_id)\r\n",
        "    FROM workspace.default.gold_stop_activity\r\n",
        ")\r\n",
        "AND total_stop_events > 0\r\n",
        "ORDER BY total_stop_events DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "9a48ce59",
      "displayName": "Network Overview KPIs",
      "queryLines": [
        "SELECT\r\n",
        "    (\r\n",
        "        SELECT COUNT(*)\r\n",
        "        FROM workspace.default.gold_route_statistics\r\n",
        "        WHERE snapshot_id = (\r\n",
        "            SELECT MAX(snapshot_id)\r\n",
        "            FROM workspace.default.gold_route_statistics\r\n",
        "        )\r\n",
        "    ) AS total_routes,\r\n",
        "\r\n",
        "    (\r\n",
        "        SELECT COUNT(*)\r\n",
        "        FROM workspace.default.gold_stop_activity\r\n",
        "        WHERE snapshot_id = (\r\n",
        "            SELECT MAX(snapshot_id)\r\n",
        "            FROM workspace.default.gold_stop_activity\r\n",
        "        )\r\n",
        "    ) AS total_stops,\r\n",
        "\r\n",
        "    (\r\n",
        "        SELECT COUNT(*)\r\n",
        "        FROM workspace.default.silver_trips\r\n",
        "        WHERE snapshot_id = (\r\n",
        "            SELECT MAX(snapshot_id)\r\n",
        "            FROM workspace.default.silver_trips\r\n",
        "        )\r\n",
        "    ) AS total_trip_records;"
      ]
    },
    {
      "name": "9494f8b8",
      "displayName": "Latest Snapshot Changes",
      "queryLines": [
        "-- Dataset: Latest Snapshot Changes\r\n",
        "SELECT\r\n",
        "  previous_snapshot_id,\r\n",
        "  current_snapshot_id,\r\n",
        "  previous_routes,\r\n",
        "  current_routes,\r\n",
        "  routes_added,\r\n",
        "  routes_removed,\r\n",
        "  current_routes - previous_routes AS net_route_change,\r\n",
        "  previous_stops,\r\n",
        "  current_stops,\r\n",
        "  stops_added,\r\n",
        "  stops_removed,\r\n",
        "  current_stops - previous_stops AS net_stop_change,\r\n",
        "  previous_trips,\r\n",
        "  current_trips,\r\n",
        "  trips_added,\r\n",
        "  trips_removed,\r\n",
        "  current_trips - previous_trips AS net_trip_change,\r\n",
        "  shared_departure_dates,\r\n",
        "  previous_shared_date_departures,\r\n",
        "  current_shared_date_departures,\r\n",
        "  shared_date_departures_change\r\n",
        "FROM workspace.default.gold_snapshot_changes\r\n",
        "ORDER BY current_snapshot_id DESC\r\n",
        "LIMIT 1;\r\n"
      ]
    },
    {
      "name": "442e14e2",
      "displayName": "Added Removed by Type",
      "queryLines": [
        "-- Dataset: Added and Removed by Type (latest snapshot pair)\r\n",
        "WITH latest AS (\r\n",
        "  SELECT * FROM workspace.default.gold_snapshot_changes\r\n",
        "  ORDER BY current_snapshot_id DESC\r\n",
        "  LIMIT 1\r\n",
        ")\r\n",
        "SELECT 'Routes' AS entity_type, routes_added AS added, routes_removed AS removed FROM latest\r\n",
        "UNION ALL\r\n",
        "SELECT 'Stops', stops_added, stops_removed FROM latest\r\n",
        "UNION ALL\r\n",
        "SELECT 'Trips', trips_added, trips_removed FROM latest;\r\n"
      ]
    },
    {
      "name": "bba762a4",
      "displayName": "Snapshot Change History",
      "queryLines": [
        "-- Dataset: Snapshot Change History\r\n",
        "-- Snapshot ID is a feed download identifier, not a service date.\r\n",
        "SELECT\r\n",
        "  current_snapshot_id,\r\n",
        "  previous_snapshot_id,\r\n",
        "  current_routes - previous_routes AS net_route_change,\r\n",
        "  current_stops - previous_stops AS net_stop_change,\r\n",
        "  current_trips - previous_trips AS net_trip_change,\r\n",
        "  routes_added, routes_removed,\r\n",
        "  stops_added, stops_removed,\r\n",
        "  trips_added, trips_removed,\r\n",
        "  shared_departure_dates,\r\n",
        "  shared_date_departures_change\r\n",
        "FROM workspace.default.gold_snapshot_changes\r\n",
        "ORDER BY current_snapshot_id ASC;\r\n"
      ]
    }
  ],
